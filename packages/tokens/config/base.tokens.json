{
  "color": {
    "$type": "color",
    "$description": "The colours that sit outside the ramps, the same in both themes. White and black are for where a design means white or black and not the end of a ramp. The constants are Spacefast's signal fills, which keep one value in light and dark: its marker, success and warning. Chartreuse, grass, teal, steel, rose and orange are the six colours a chart paints its series with, chosen by hand; each is also the seed of the qualitative ramp of its name (leonardo.colors.js).",
    "white": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "black": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 1,
        "hex": "#000000"
      }
    },
    "constant": {
      "lime": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.8471,
            0.949,
            0.2941
          ],
          "alpha": 1,
          "hex": "#d8f24b"
        }
      },
      "green": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.5451,
            0.898,
            0.5137
          ],
          "alpha": 1,
          "hex": "#8be583"
        }
      },
      "amber": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9843,
            0.7137,
            0.0196
          ],
          "alpha": 1,
          "hex": "#fbb605"
        }
      },
      "chartreuse": {
        "$value": "{color.constant.lime}"
      },
      "grass": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2706,
            0.8235,
            0.5373
          ],
          "alpha": 1,
          "hex": "#45d289"
        }
      },
      "teal": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0,
            0.6275,
            0.6039
          ],
          "alpha": 1,
          "hex": "#00a09a"
        }
      },
      "steel": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2235,
            0.3608,
            0.5216
          ],
          "alpha": 1,
          "hex": "#395c85"
        }
      },
      "rose": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9608,
            0.0,
            0.4196
          ],
          "alpha": 1,
          "hex": "#f5006b"
        }
      },
      "orange": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            0.4392,
            0.1176
          ],
          "alpha": 1,
          "hex": "#ff701e"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Corner radii. Spacefast's radius variables, taken as they are: a t-shirt scale of fixed values is already a primitive.",
    "xs": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "2xl": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  }
}

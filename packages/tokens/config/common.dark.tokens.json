{
  "color": {
    "$type": "color",
    "$description": "Dark-theme overrides for common.tokens.json. A ramp flips with the theme, so most tokens need none.",
    "primary": {
      "$value": "{color.white}"
    },
    "primary-foreground": {
      "$value": "{color.neutral.200}"
    },
    "primary-text": {
      "$value": "{color.white}"
    },
    "btn-primary-from": {
      "$value": "{color.white}"
    },
    "secondary": {
      "$value": "{color.neutral.500}"
    },
    "muted": {
      "$value": "{color.neutral.500}"
    },
    "muted-foreground": {
      "$value": "{color.neutral.800}"
    },
    "accent": {
      "$value": "{color.neutral.500}"
    },
    "border": {
      "$value": "{color.neutral.500}"
    },
    "destructive-soft": {
      "$value": "{color.red.300}"
    },
    "success-text": {
      "$value": "{color.green.900}"
    },
    "success-soft": {
      "$value": "{color.green.500}"
    },
    "warning-text": {
      "$value": "{color.amber.900}"
    },
    "warning-soft": {
      "$value": "{color.amber.500}"
    },
    "info": {
      "$value": "{color.blue.900}"
    },
    "info-soft": {
      "$value": "{color.blue.500}"
    },
    "live": {
      "$value": "{color.lime.1000}"
    },
    "seq-1": {
      "$value": "{color.seq.100}"
    },
    "seq-2": {
      "$value": "{color.seq.200}"
    },
    "seq-3": {
      "$value": "{color.seq.300}"
    },
    "seq-4": {
      "$value": "{color.seq.400}"
    },
    "seq-5": {
      "$value": "{color.seq.500}"
    },
    "seq-6": {
      "$value": "{color.seq.600}"
    },
    "seq-7": {
      "$value": "{color.seq.700}"
    },
    "seq-8": {
      "$value": "{color.seq.800}"
    },
    "seq-9": {
      "$value": "{color.seq.900}"
    },
    "seq-10": {
      "$value": "{color.seq.1000}"
    },
    "seq-none": {
      "$value": "{color.neutral.500}"
    },
    "switch-thumb-off": {
      "$value": "{color.neutral.1000}"
    },
    "sidebar-foreground-muted": {
      "$value": "{color.neutral.800}"
    },
    "sidebar-accent": {
      "$value": "{color.neutral.400}"
    },
    "sidebar-active-foreground": {
      "$value": "{color.neutral.200}"
    },
    "sidebar-border": {
      "$value": "{color.neutral.500}"
    },
    "skeleton": {
      "$value": "{color.neutral.500}"
    },
    "raised": {
      "$value": "{color.neutral.500}"
    },
    "on-ink": {
      "$value": "{color.neutral.200}"
    },
    "well": {
      "$value": "color-mix(in srgb, {color.foreground} 6%, transparent)"
    },
    "destructive-tint": {
      "$value": "color-mix(in srgb, {color.destructive} 20%, transparent)"
    },
    "ring": {
      "$value": "color-mix(in srgb, {color.primary} 60%, transparent)"
    },
    "overlay": {
      "$value": "color-mix(in srgb, {color.black} 80%, transparent)"
    },
    "kbd-on-inverse": {
      "$value": "color-mix(in srgb, {color.background} 10%, transparent)"
    }
  }
}

{
  "color": {
    "$type": "color",
    "$description": "Dark-theme overrides for common.tokens.json. A ramp flips with the theme, so most tokens need none.",
    "primary": {
      "$value": "{color.white}"
    },
    "primary-foreground": {
      "$value": "{color.neutral.200}"
    },
    "primary-text": {
      "$value": "{color.white}"
    },
    "btn-primary-from": {
      "$value": "{color.white}"
    },
    "secondary": {
      "$value": "{color.neutral.500}"
    },
    "muted": {
      "$value": "{color.neutral.500}"
    },
    "muted-foreground": {
      "$value": "{color.neutral.800}"
    },
    "accent": {
      "$value": "{color.neutral.500}"
    },
    "border": {
      "$value": "{color.neutral.500}"
    },
    "destructive-soft": {
      "$value": "{color.red.300}"
    },
    "success-text": {
      "$value": "{color.green.900}"
    },
    "success-soft": {
      "$value": "{color.green.500}"
    },
    "warning-text": {
      "$value": "{color.amber.900}"
    },
    "warning-soft": {
      "$value": "{color.amber.500}"
    },
    "info": {
      "$value": "{color.blue.900}"
    },
    "info-soft": {
      "$value": "{color.blue.500}"
    },
    "live": {
      "$value": "{color.lime.1000}"
    },
    "seq-none": {
      "$value": "{color.neutral.500}"
    },
    "switch-thumb-off": {
      "$value": "{color.neutral.1000}"
    },
    "sidebar-foreground-muted": {
      "$value": "{color.neutral.800}"
    },
    "sidebar-accent": {
      "$value": "{color.neutral.400}"
    },
    "sidebar-active-foreground": {
      "$value": "{color.neutral.200}"
    },
    "sidebar-border": {
      "$value": "{color.neutral.500}"
    },
    "skeleton": {
      "$value": "{color.neutral.500}"
    },
    "raised": {
      "$value": "{color.neutral.500}"
    },
    "on-ink": {
      "$value": "{color.neutral.200}"
    },
    "overlay": {
      "$value": "color-mix(in srgb, {color.black} {opacity.scrim}, transparent)"
    },
    "muted-50": {
      "$value": "{color.neutral.400}"
    },
    "marker-soft": {
      "$value": "{color.lime.600}"
    },
    "kbd-on-inverse": {
      "$value": "{color.neutral.1000}"
    }
  },
  "light": {
    "$description": "In dark a highlight is weaker and nothing is shaded.",
    "hi": {
      "$value": 0.8
    },
    "lo": {
      "$value": 0
    }
  }
}
